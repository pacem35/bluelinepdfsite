---
import Base from '../layouts/Base.astro';
import ProofSheet from '../components/ProofSheet.astro';
import Plans from '../components/Plans.astro';
import { capabilities, site } from '../config/site';
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Every PDF, ready to send.</h1>
        <p class="lede">{site.name} is a desktop editor for the documents you sign, fix and pass along: contracts, forms, statements, scans.</p>
        <div class="actions">
          <a class="btn" href="/pricing/">See plans</a>
          <a class="btn secondary" href="/login/" data-auth="signed-out">Sign in</a>
          <a class="btn secondary" href="/account/" data-auth="signed-in" hidden>Download</a>
        </div>
      </div>
      <ProofSheet />
    </div>
  </section>

  <section class="what wrap" aria-labelledby="what-h">
    <h2 id="what-h">What it does</h2>
    <dl class="caps">
      {capabilities.map((c) => (
        <div>
          <dt>{c.verb}</dt>
          <dd>{c.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="pricing wrap" aria-labelledby="pricing-h">
    <div class="section-head">
      <h2 id="pricing-h">Plans</h2>
      <p>Same software on every plan. Pick how you'd like to pay.</p>
    </div>
    <Plans />
  </section>
</Base>

<style>
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5.5rem); border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero h1 { font-variation-settings: 'wdth' 125; font-weight: 800; max-width: 11ch; }
  .lede { font-size: var(--t-2); color: var(--muted); margin: 1.4rem 0 2rem; max-width: 34ch; line-height: 1.45; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .what { padding-top: 5rem; }
  .caps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 3.5rem; margin: 2rem 0 0; }
  .caps > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid var(--rule); }
  .caps dt { font-weight: 700; font-variation-settings: 'wdth' 118; color: var(--blue); font-size: var(--t-2); line-height: 1.2; }
  .caps dd { margin: 0; color: var(--ink); }

  .pricing { padding-top: 5.5rem; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 2rem; margin-bottom: 1.6rem; }
  .section-head p { color: var(--muted); margin: 0; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .caps { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .caps > div { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
