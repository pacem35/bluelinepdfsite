---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
---
<Base title="Pricing" description="Monthly, yearly or a one-time lifetime license for Blueline PDF.">
  <div class="wrap">
    <header class="page-head">
      <h1>Pricing</h1>
      <p>Every plan includes the full editor and updates for as long as it's active.</p>
    </header>
    <p class="notice" id="cancelled" hidden>Checkout was cancelled. You haven't been charged.</p>
    <Plans />
    <section class="faq prose" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions</h2>
      <h3>How do I get the installer?</h3>
      <p>After checkout, your account page has a download button for each platform. Links are personal and expire after a few minutes, so come back to your account whenever you need a fresh one.</p>
      <h3>Can I switch or cancel?</h3>
      <p>Yes. Open your account and choose Manage billing to change plan, update your card, download invoices or cancel. A cancelled plan keeps working until the end of the period you paid for.</p>
      <h3>What does lifetime cover?</h3>
      <p>One payment for the current major version, including its updates. You won't be billed again.</p>
    </section>
  </div>
</Base>

<style>
  .faq { margin-top: 4rem; max-width: 46rem; }
  .faq h3 { margin: 1.6rem 0 0.4rem; }
</style>

<script>
  if (new URLSearchParams(location.search).get('checkout') === 'cancelled') {
    document.getElementById('cancelled')!.hidden = false;
  }
</script>
