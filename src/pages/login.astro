---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in" noindex>
  <section class="page-wrap narrow auth">
    <div class="wrap">
      <h1 id="heading">Sign in</h1>
      <p class="page-lead" id="sub">For agency contacts: license keys, invoices and the vendor packet. The Officer Edition doesn’t need an account.</p>

      <div class="panel">
        <div class="form-msg info" id="vendorNote" hidden>Sign in to download the vendor packet. Any work email works; you don’t need a license.</div>
        <div class="form-msg err" id="unconfigured" hidden>Sign-in isn’t connected yet. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY and rebuild.</div>
        <div class="form-msg err" id="error" role="alert" hidden></div>
        <div class="form-msg ok" id="ok" role="status" hidden></div>

        <form id="form" novalidate style="display:grid;gap:16px">
          <div><label for="email">Work email</label><input id="email" name="email" type="email" autocomplete="email" placeholder="records@agency.gov" required></div>
          <div><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" minlength="8" required></div>
          <button class="btn btn-gold" id="submit" type="submit">Sign in</button>
        </form>

        <div class="alt">
          <button class="linkish" id="magic" type="button">Email me a sign-in link instead</button>
          <span><span id="switch-label">New here?</span>{' '}<button class="linkish" id="switch" type="button">Create an account</button></span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .panel .form-msg { margin-bottom: 16px; }
</style>

<script>
  import { supabase, authConfigured } from '../lib/supabase';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('form');
  const email = $<HTMLInputElement>('email');
  const password = $<HTMLInputElement>('password');
  const submit = $<HTMLButtonElement>('submit');
  const errorBox = $('error');
  const okBox = $('ok');

  const params = new URLSearchParams(location.search);
  // Only same-site relative paths are allowed as the post-login destination.
  const rawNext = params.get('next') ?? '/account/';
  const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/account/';
  if (params.get('reason') === 'vendor') $('vendorNote').hidden = false;

  let mode: 'signin' | 'signup' = params.get('mode') === 'signup' ? 'signup' : 'signin';

  function render() {
    const signup = mode === 'signup';
    $('heading').textContent = signup ? 'Create an account' : 'Sign in';
    submit.textContent = signup ? 'Create account' : 'Sign in';
    password.autocomplete = signup ? 'new-password' : 'current-password';
    $('switch-label').textContent = signup ? 'Already have an account?' : 'New here?';
    $('switch').textContent = signup ? 'Sign in' : 'Create an account';
  }

  function show(box: HTMLElement, msg: string) {
    errorBox.hidden = okBox.hidden = true;
    box.textContent = msg;
    box.hidden = false;
  }

  function busy(on: boolean) {
    submit.disabled = on;
    submit.toggleAttribute('aria-busy', on);
  }

  if (!authConfigured) {
    $('unconfigured').hidden = false;
    document.querySelectorAll<HTMLButtonElement | HTMLInputElement>('.panel input, .panel button').forEach((el) => (el.disabled = true));
  } else {
    supabase.auth.getSession().then(({ data }) => data.session && location.replace(next));
  }

  $('switch').addEventListener('click', () => {
    mode = mode === 'signin' ? 'signup' : 'signin';
    errorBox.hidden = okBox.hidden = true;
    render();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!email.value || !email.checkValidity()) return show(errorBox, 'Enter a valid email address.');
    if (password.value.length < 8) return show(errorBox, 'Passwords are at least 8 characters.');
    busy(true);
    try {
      if (mode === 'signin') {
        const { error } = await supabase.auth.signInWithPassword({ email: email.value, password: password.value });
        if (error) throw error;
        location.replace(next);
      } else {
        const { data, error } = await supabase.auth.signUp({
          email: email.value,
          password: password.value,
          options: { emailRedirectTo: new URL(next, location.origin).href },
        });
        if (error) throw error;
        if (data.session) location.replace(next);
        else show(okBox, `We sent a confirmation link to ${email.value}. Open it to finish creating your account.`);
      }
    } catch (err) {
      show(errorBox, err instanceof Error ? err.message : 'Sign-in failed. Try again.');
    } finally {
      busy(false);
    }
  });

  $('magic').addEventListener('click', async () => {
    if (!email.value || !email.checkValidity()) return show(errorBox, 'Enter your email first, then ask for a link.');
    const { error } = await supabase.auth.signInWithOtp({
      email: email.value,
      options: { emailRedirectTo: new URL(next, location.origin).href },
    });
    if (error) show(errorBox, error.message);
    else show(okBox, `Sign-in link sent to ${email.value}. It works once and expires in an hour.`);
  });

  render();
</script>
