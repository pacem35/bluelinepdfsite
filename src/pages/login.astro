---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in" noindex>
  <div class="narrow auth">
    <h1 id="heading">Sign in</h1>
    <p class="sub" id="sub">Use the email you bought with to reach your downloads and billing.</p>

    <p class="notice error" id="error" role="alert" hidden></p>
    <p class="notice ok" id="ok" role="status" hidden></p>
    <p class="notice error" id="unconfigured" hidden>
      Sign-in isn't connected yet. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY and rebuild.
    </p>

    <form id="form" novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" minlength="8" required />
      </div>
      <button class="btn full" id="submit" type="submit">Sign in</button>
    </form>

    <div class="alt">
      <button class="linkish" id="magic" type="button">Email me a sign-in link instead</button>
      <p id="switch-row">
        <span id="switch-label">New to Blueline PDF?</span>{' '}
        <button class="linkish" id="switch" type="button">Create an account</button>
      </p>
    </div>
  </div>
</Base>

<style>
  .auth { padding: 4rem 0 2rem; }
  .sub { color: var(--muted); margin: 0.8rem 0 2rem; }
  .full { width: 100%; margin-top: 0.4rem; }
  .alt { margin-top: 1.6rem; display: grid; gap: 0.6rem; }
  .alt p { margin: 0; color: var(--muted); }
  .linkish { font: inherit; color: var(--blue); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 0.18em; justify-self: start; }
</style>

<script>
  import { supabase, authConfigured } from '../lib/supabase';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('form');
  const email = $<HTMLInputElement>('email');
  const password = $<HTMLInputElement>('password');
  const submit = $<HTMLButtonElement>('submit');
  const errorBox = $('error');
  const okBox = $('ok');

  const params = new URLSearchParams(location.search);
  // Only same-site relative paths are allowed as a post-login destination.
  const rawNext = params.get('next') ?? '/account/';
  const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/account/';
  const plan = params.get('plan');
  const destination = plan ? `${next}${next.includes('?') ? '&' : '?'}plan=${encodeURIComponent(plan)}` : next;

  let mode: 'signin' | 'signup' = params.get('mode') === 'signup' ? 'signup' : 'signin';

  function render() {
    const signup = mode === 'signup';
    $('heading').textContent = signup ? 'Create your account' : 'Sign in';
    $('sub').textContent = signup
      ? 'You’ll use this account to download Blueline PDF and manage billing.'
      : 'Use the email you bought with to reach your downloads and billing.';
    submit.textContent = signup ? 'Create account' : 'Sign in';
    password.autocomplete = signup ? 'new-password' : 'current-password';
    $('switch-label').textContent = signup ? 'Already have an account?' : 'New to Blueline PDF?';
    $('switch').textContent = signup ? 'Sign in' : 'Create an account';
  }

  function show(box: HTMLElement, msg: string) {
    errorBox.hidden = true;
    okBox.hidden = true;
    box.textContent = msg;
    box.hidden = false;
  }

  function busy(on: boolean) {
    submit.disabled = on;
    submit.toggleAttribute('aria-busy', on);
  }

  if (!authConfigured) {
    $('unconfigured').hidden = false;
    form.querySelectorAll('input,button').forEach((el) => ((el as HTMLButtonElement).disabled = true));
  }

  supabase.auth.getSession().then(({ data }) => {
    if (data.session) location.replace(destination);
  });

  $('switch').addEventListener('click', () => {
    mode = mode === 'signin' ? 'signup' : 'signin';
    errorBox.hidden = okBox.hidden = true;
    render();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!email.value || !email.checkValidity()) return show(errorBox, 'Enter a valid email address.');
    if (password.value.length < 8) return show(errorBox, 'Passwords are at least 8 characters.');
    busy(true);
    try {
      if (mode === 'signin') {
        const { error } = await supabase.auth.signInWithPassword({ email: email.value, password: password.value });
        if (error) throw error;
        location.replace(destination);
      } else {
        const { data, error } = await supabase.auth.signUp({
          email: email.value,
          password: password.value,
          options: { emailRedirectTo: new URL(destination, location.origin).href },
        });
        if (error) throw error;
        if (data.session) location.replace(destination);
        else show(okBox, `We sent a confirmation link to ${email.value}. Open it to finish creating your account.`);
      }
    } catch (err) {
      show(errorBox, err instanceof Error ? err.message : 'Sign-in failed. Try again.');
    } finally {
      busy(false);
    }
  });

  $('magic').addEventListener('click', async () => {
    if (!email.value || !email.checkValidity()) return show(errorBox, 'Enter your email first, then ask for a link.');
    const { error } = await supabase.auth.signInWithOtp({
      email: email.value,
      options: { emailRedirectTo: new URL(destination, location.origin).href },
    });
    if (error) show(errorBox, error.message);
    else show(okBox, `Sign-in link sent to ${email.value}. It works once and expires in an hour.`);
  });

  render();
</script>
