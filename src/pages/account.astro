---
import Base from '../layouts/Base.astro';
import { planNames, site } from '../config/site';
---
<Base title="Your account" noindex>
  <section class="page-wrap">
    <div class="wrap">
      <h1>Your account</h1>
      <p class="page-lead" id="who">Loading…</p>
      <div class="form-msg err" id="error" role="alert" hidden></div>

      <div class="acct-grid">
        <div id="agencies" data-plans={JSON.stringify(planNames)}>
          <div class="panel" id="noAgency" hidden>
            <h2>No agency linked to this email</h2>
            <p class="muted" style="margin-top:8px">Licenses appear here for the contact email on your agency’s quote or invoice. If you’re running a pilot or have bought licenses, sign in with that address, or email <a href={`mailto:${site.contactEmail}`} style="color:var(--blue-2)">{site.contactEmail}</a> to be added.</p>
            <a href="/#contact" class="btn btn-ghost" style="margin-top:18px">Request a quote or pilot</a>
          </div>
        </div>

        <aside class="panel">
          <h2>Downloads</h2>
          <p class="sub">The same installer runs every edition. Enter your license key in Blueline to unlock agency features.</p>
          <div class="side-list">
            <a class="btn btn-gold" href="/api/download">Download Blueline for Windows</a>
            <a class="btn btn-ghost" href="/api/resource?name=security-summary">Security &amp; CJIS summary (PDF)</a>
            <button class="btn btn-ghost" type="button" id="vendor">Vendor packet: W-9, EULA, quote template (ZIP)</button>
          </div>
          <div class="side-list" style="margin-top:22px">
            <button class="btn btn-ghost" type="button" id="signout">Sign out</button>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<template id="agencyTpl">
  <div class="panel agency">
    <div class="agency-head">
      <div><h2 class="a-name"></h2><p class="sub a-ori"></p></div>
      <button class="btn btn-ghost btn-sm a-billing" type="button" hidden>Invoices &amp; billing</button>
    </div>
    <p class="muted small a-empty" hidden style="margin-top:14px">No licenses yet. They appear here as soon as an invoice is paid or a pilot starts.</p>
    <table class="lic-table">
      <thead><tr><th>Plan</th><th>Seats</th><th>Status</th><th>Dates</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
</template>

<script>
  import { supabase, getSession, authConfigured } from '../lib/supabase';
  import { api } from '../lib/api';

  interface License {
    key: string; plan: string; kind: 'subscription' | 'term' | 'perpetual' | 'pilot'; seats: number; status: string; active: boolean;
    renewsAt: string | null; expiresAt: string | null; cancelAtPeriodEnd: boolean; maintenanceUntil: string | null;
  }
  interface Agency { id: string; name: string; ori: string | null; hasBilling: boolean; licenses: License[] }
  interface Me { email: string; agencies: Agency[] }

  const planNames: Record<string, string> = JSON.parse(document.getElementById('agencies')?.dataset.plans ?? '{}');
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const showError = (msg: string) => { $('error').textContent = msg; $('error').hidden = false; };
  const fmt = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '');

  const kindLabel = { subscription: 'Annual', term: 'Annual', perpetual: 'Perpetual', pilot: 'Pilot' } as const;

  function statusOf(l: License): { text: string; tone: 'on' | 'warn' | 'off' } {
    if (l.status === 'revoked') return { text: 'Revoked', tone: 'off' };
    if (!l.active) return { text: l.kind === 'subscription' ? (l.status === 'canceled' ? 'Ended' : 'Inactive') : 'Expired', tone: 'off' };
    if (l.status === 'past_due') return { text: 'Payment overdue', tone: 'warn' };
    if (l.kind === 'subscription' && l.cancelAtPeriodEnd) return { text: 'Ending', tone: 'warn' };
    return { text: 'Active', tone: 'on' };
  }

  function datesOf(l: License): string {
    switch (l.kind) {
      case 'subscription': return l.renewsAt ? `${l.cancelAtPeriodEnd ? 'Ends' : 'Renews'} ${fmt(l.renewsAt)}` : '';
      case 'term': return l.expiresAt ? `Paid through ${fmt(l.expiresAt)}` : '';
      case 'pilot': return l.expiresAt ? `Pilot ends ${fmt(l.expiresAt)}` : '';
      case 'perpetual': {
        if (!l.maintenanceUntil) return 'No maintenance';
        const current = new Date(l.maintenanceUntil) > new Date();
        return `${current ? 'Updates through' : 'Updates ended'} ${fmt(l.maintenanceUntil)}`;
      }
    }
  }

  function cell(tr: HTMLTableRowElement, cls = '') {
    const td = document.createElement('td');
    if (cls) td.className = cls;
    tr.append(td);
    return td;
  }

  function renderAgency(a: Agency) {
    const node = ($<HTMLTemplateElement>('agencyTpl').content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    node.querySelector('.a-name')!.textContent = a.name;
    node.querySelector('.a-ori')!.textContent = a.ori ? `ORI ${a.ori}` : '';
    const billing = node.querySelector<HTMLButtonElement>('.a-billing')!;
    billing.hidden = !a.hasBilling;
    billing.addEventListener('click', async () => {
      billing.setAttribute('aria-busy', 'true');
      try {
        const { url } = await api<{ url: string }>('/api/portal', { method: 'POST', body: JSON.stringify({ agencyId: a.id }) });
        location.assign(url);
      } catch (e) {
        billing.removeAttribute('aria-busy');
        showError(e instanceof Error ? e.message : 'Billing couldn’t open.');
      }
    });

    const tbody = node.querySelector('tbody')!;
    node.querySelector<HTMLElement>('.a-empty')!.hidden = a.licenses.length > 0;
    node.querySelector<HTMLElement>('table')!.hidden = a.licenses.length === 0;

    for (const l of a.licenses) {
      const tr = document.createElement('tr');
      const plan = cell(tr);
      plan.innerHTML = '<strong></strong><div class="muted small"></div>';
      plan.querySelector('strong')!.textContent = planNames[l.plan] ?? l.plan;
      plan.querySelector('div')!.textContent = kindLabel[l.kind];
      cell(tr).textContent = String(l.seats);
      const st = statusOf(l);
      const pill = document.createElement('span');
      pill.className = `pill ${st.tone}`;
      pill.textContent = st.text;
      cell(tr).append(pill);
      cell(tr, 'muted small').textContent = datesOf(l);
      tbody.append(tr);

      const keyRow = document.createElement('tr');
      const keyCell = cell(keyRow, 'k');
      keyCell.colSpan = 4;
      keyCell.innerHTML = '<span class="key"><span class="muted">License key</span> <code></code> <button type="button" class="copy-btn">Copy</button></span>';
      keyCell.querySelector('code')!.textContent = l.key;
      const copy = keyCell.querySelector<HTMLButtonElement>('.copy-btn')!;
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(l.key); copy.textContent = 'Copied'; }
        catch { copy.textContent = 'Select and copy'; }
        setTimeout(() => (copy.textContent = 'Copy'), 2000);
      });
      tbody.append(keyRow);
    }
    $('agencies').append(node);
  }

  async function main() {
    if (!authConfigured) return showError('Sign-in isn’t connected yet. See docs/SETUP.md.');
    if (!(await getSession())) return location.replace('/login/?next=%2Faccount%2F');
    const me = await api<Me>('/api/me');
    $('who').textContent = `Signed in as ${me.email}`;
    if (me.agencies.length === 0) $('noAgency').hidden = false;
    me.agencies.forEach(renderAgency);
  }

  $('vendor').addEventListener('click', async () => {
    try {
      const { url } = await api<{ url: string }>('/api/resource?name=vendor-packet');
      location.assign(url);
    } catch (e) {
      showError(e instanceof Error ? e.message : 'The vendor packet couldn’t be downloaded.');
    }
  });

  $('signout').addEventListener('click', async () => {
    await supabase.auth.signOut();
    location.replace('/');
  });

  main().catch((e) => showError(e instanceof Error ? e.message : 'Your account couldn’t load.'));
</script>
