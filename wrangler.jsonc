// Cloudflare Worker that serves the static site (./dist) and the /api routes.
// Connect this repo in the Cloudflare dashboard (Workers & Pages → Create → Import a repository)
// and every push to main deploys automatically. See docs/SETUP.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluelinepdf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only /api/* hits the Worker; every other request is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (keys) are set with `wrangler secret put` or in the dashboard.
  "vars": {
    "SITE_URL": "http://localhost:8787",
    "R2_BUCKET": "blueline-installers",
    "DOWNLOAD_URL_TTL_SECONDS": "300",
    "STRIPE_PRICE_MONTHLY": "",
    "STRIPE_PRICE_YEARLY": "",
    "STRIPE_PRICE_LIFETIME": ""
  }
}
