# Build-time values baked into the browser bundle. These are public by design.
# Locally: copy to .env. In Cloudflare: add them as Build variables (Settings → Build).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key for the quote form (pair with TURNSTILE_SECRET_KEY on the Worker)
PUBLIC_TURNSTILE_SITE_KEY=
